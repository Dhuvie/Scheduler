# =====================================================
# Backend Environment Variables
# =====================================================

# --- Database ---
DATABASE_URL="postgresql://scheduler:scheduler_pass@localhost:5432/scheduler_db"

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT="6379"

# --- Server ---
PORT="3001"
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# --- BullMQ / Worker ---
WORKER_CONCURRENCY="5"

# --- Rate Limiting ---
MAX_EMAILS_PER_HOUR="100"
MAX_EMAILS_PER_HOUR_PER_SENDER="50"
MIN_DELAY_BETWEEN_SENDS_MS="2000"

# --- Ethereal Email ---
# These are auto-generated when you run the server for the first time.
# Optionally hardcode test credentials from https://ethereal.email/create
ETHEREAL_USER="bettie.stehr89@ethereal.email"
ETHEREAL_PASS="K8PvnJ7hyxB9DVMFFv"
