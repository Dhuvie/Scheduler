// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id             String   @id @default(uuid())
  subject        String
  bodyTemplate   String
  startTime      DateTime
  delayBetweenMs Int      // ms delay between consecutive emails
  hourlyLimit    Int      // max emails per hour for this campaign
  sender         String   // sender email address / identity
  status         String   @default("active") // active | completed | paused
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  emails Email[]

  @@map("campaigns")
}

model Email {
  id           String    @id @default(uuid())
  campaignId   String
  emailAddress String
  subject      String
  body         String
  scheduledTime DateTime
  status       String    @default("pending") // pending | scheduled | sending | sent | failed | rescheduled
  sender       String
  bullmqJobId  String?   @unique // deterministic job id: "email_send_{id}"
  attemptCount Int       @default(0)
  lastError    String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([status])
  @@index([campaignId])
  @@index([scheduledTime])
  @@map("emails")
}
